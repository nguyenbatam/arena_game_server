# Arena game server — configuration.
#
# Copy to backend.env and edit:   make env
# docker-compose reads backend.env; values under a service's `environment:`
# key still win over this file, which is where the compose topology puts
# REDIS_ADDR and KAFKA_BROKERS so they point at the right containers.
#
# The defaults here are the PRODUCTION-SAFE ones. Load testing needs several of
# them relaxed — do that in backend.loadtest.env, never by editing this file,
# so a load-test setting cannot ride into a deployment.

# ---------------------------------------------------------------------------
# Identity and role
# ---------------------------------------------------------------------------
# all | gateway | matchmaker | gameserver. `all` runs every role in one process.
ROLE=all
NODE_ID=local-1
# development | production. `production` turns on TRUST_PROXY, applies a default
# QUEUE_RATE_LIMIT, requires ADMIN_TOKEN for /admin/config, /debug/pprof and
# /stats, warns on startup about any rate limiter left switched off — and
# REFUSES TO START without JWT_SECRET, because with it unset any client can
# claim any identity.
ENV=production

# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
TCP_ADDR=:8081
UDP_ADDR=:8082
# What a gateway tells clients to reconnect to. Must be reachable BY THE CLIENT,
# so it is a public hostname, never a container name.
PUBLIC_ADDR=ws://localhost:8080/ws

# ---------------------------------------------------------------------------
# Backing services — leave REDIS_ADDR empty for single-process in-memory mode
# ---------------------------------------------------------------------------
REDIS_ADDR=
REDIS_PASSWORD=
KAFKA_BROKERS=
KAFKA_TOPIC=arena.events

# ---------------------------------------------------------------------------
# The platform tier — accounts, profiles, inventory, currency, the store, match
# history and the leaderboard. Everything that has to outlive the process.
#
# One variable decides the mode, the way REDIS_ADDR does:
#
#   empty           off. /auth/login hands a token to whoever asks and nothing a
#                   player does survives a restart. This is the realtime tier on
#                   its own, which is what the rest of this repo is about.
#   memory          on, with no database. Every rule is enforced and nothing is
#                   durable — right for a demo, wrong for anything else, and
#                   ENV=production says so loudly on startup.
#   a postgres URL  on, durable. docker-compose sets this to its own container.
#
# With the tier on, /auth/login stops accepting a bare name: registration at
# /auth/register is the only way to get a session. There is no anonymous door
# left, because every platform read is authorised by that same token.
PLATFORM_DSN=
# Connections held against the database. Every replica opens its own pool, so
# this multiplies by the fleet and has to stay well under the server's
# max_connections. Postgres does not get faster past a couple per core.
PLATFORM_MAX_CONNS=16
# Ceiling on one database call. Wider than REDIS_TIMEOUT on purpose: a purchase
# is a transaction across four tables, not a key-value lookup.
PLATFORM_TIMEOUT=2s

# ---------------------------------------------------------------------------
# Security. Every one of these is required in a real deployment.
# ---------------------------------------------------------------------------
# Empty disables JWT entirely and lets any client name itself anything, so
# ENV=production refuses to boot without it. The value below is a placeholder
# that exists only so `make docker` starts out of the box — replace it, and do
# not let it reach a deployment.
JWT_SECRET=change-me-this-is-a-placeholder-not-a-secret
JWT_TTL=24h
# Guards /admin/config and /debug/pprof. With ENV=production and no token, those
# endpoints refuse every request rather than falling open.
ADMIN_TOKEN=
# Comma-separated. Empty allows every Origin, which is only right behind a proxy
# that already filters them.
ALLOWED_ORIGINS=
# Only ever true behind a proxy that overwrites X-Forwarded-For. Trusting the
# header on a directly-exposed server lets any client forge its own IP and walk
# straight through every per-IP rate limit below.
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Rate limits — per client IP, per minute. 0 disables the limiter.
#
# These are the gateway's only defence against a connection flood, so 0 belongs
# in a load-test file and nowhere else: every bot dials from one IP, so the
# limiters would cap the whole fleet and the run measures the limiter instead of
# the server. ENV=production logs a warning for each one left at 0.
# ---------------------------------------------------------------------------
HELLO_RATE_LIMIT=60
QUEUE_RATE_LIMIT=12
LOGIN_RATE_LIMIT=30
TURN_RATE_LIMIT=120
# The /platform endpoints. They are the only ones in the process that put an
# anonymous request in front of a database, and /auth/register pays for a
# password hash on top. Ignored when PLATFORM_DSN is empty.
PLATFORM_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# Per-connection budget — what ONE established connection may spend.
#
# The limiters above are keyed by IP and guard the door; they do nothing about
# an authenticated client that sends a hundred thousand inputs a second, and a
# per-IP limit tight enough to catch it would throw out everyone behind a
# carrier NAT. Charged before the protobuf is unmarshalled, because the
# unmarshal is the expensive half. 0 disables the dimension.
#
# 120 msg/s is six times what a 20 Hz client sends.
# ---------------------------------------------------------------------------
CONN_MSG_RATE=120
CONN_MSG_BURST=240
CONN_BYTE_RATE=131072
CONN_BYTE_BURST=262144

# ---------------------------------------------------------------------------
# Capacity — how many matches this node will host. 0 means no ceiling.
#
# Placement balances but never refuses, so without this a busy fleet keeps
# stacking rooms onto nodes that are already missing their tick budget. Set it
# to what a node can actually simulate: watch arena_tick_duration_seconds p99
# against the tick budget and stop below where it starts to climb.
#
# A node at its ceiling puts those players back in the queue, which shows up as
# arena_placements_refused_total — the signal to add capacity.
# ---------------------------------------------------------------------------
MAX_ROOMS=0

# ---------------------------------------------------------------------------
# Input jitter buffer — ticks of input held in reserve per player.
#
# A client at the tick rate sends one input per tick and the server consumes one
# per tick, but the network does not deliver on a metronome: one tick window
# gets two inputs and the next gets none. With one slot per player the surplus
# was thrown away and the gap left the player standing still, which the client
# had already predicted through and has to be corrected out of.
#
# 2 absorbs the ordinary case. It is a ceiling, not a delay: a steady stream is
# drained every tick and nothing is held. 1 is the old last-wins behaviour.
# Watch arena_input_buffer_dropped_total and arena_input_underruns_total —
# they move together, and both should sit near zero.
# ---------------------------------------------------------------------------
INPUT_BUFFER=2

# ---------------------------------------------------------------------------
# Snapshot rate — how many snapshots a second a room sends, independent of how
# many times a second it simulates.
#
# 0 sends one per tick, which is what this server did before the knob existed
# and is what the bandwidth table in the README is measured against.
#
# They are separate numbers in every engine that has had to pay a bandwidth
# bill: Source calls them tick and sv_updaterate, Overwatch simulates at 60 Hz
# and sends at 20. Raising TICK_RATE buys hit resolution and input latency;
# raising the send rate buys nothing but egress, and egress grows with the
# square of the room size. Tied together, TICK_RATE=60 triples every room's
# outbound traffic as a side effect of asking for a better simulation.
#
# SNAPSHOT_RATE=20 with TICK_RATE=60 is the shape worth reaching for.
# ---------------------------------------------------------------------------
SNAPSHOT_RATE=0

# ---------------------------------------------------------------------------
# Warmup — how long a room waits for its seats to connect before the match
# clock starts.
#
# The clock used to start when the placement job was taken, which is before
# anybody has been told the match exists. In one process that is milliseconds.
# Across nodes it is a handoff — MATCH_FOUND, a new socket, a HELLO and a
# JOIN_ROOM — and every second of it came out of the match, unevenly, so
# whoever arrived first got a head start on an empty map.
#
# A budget rather than a condition: a seat whose player closed the tab must not
# hold the other seven. Watch arena_match_warmup_seconds and
# arena_match_warmup_timeouts_total. 0 starts immediately.
# ---------------------------------------------------------------------------
WARMUP_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Coordination timeout — the ceiling on one Redis call made on a player's
# behalf. Presence, the queue and the room directory all sit on the connection
# path and none of them is the simulation; without a ceiling a stalled Redis
# parks every connection goroutine in the process.
# ---------------------------------------------------------------------------
REDIS_TIMEOUT=1s

# ---------------------------------------------------------------------------
# Gameplay — hot-reloadable at runtime via PUT /admin/config
# ---------------------------------------------------------------------------
# 20, 30 or 60. Anything else falls back to 20.
TICK_RATE=20
# Hard ceiling of 24: past that a full snapshot outgrows one UDP datagram and
# the transport drops it rather than fragmenting. Raising it is an interest-
# management project, not a number edit.
ROOM_SIZE=8
MIN_PLAYERS=2
# How long the matchmaker waits for a full room before filling the rest with bots.
QUEUE_TIMEOUT=2s
MATCH_SECONDS=90
# How long a dropped player keeps their seat.
# Clamped to two minutes, and the server says so when it clamps. The window is
# enforced against a presence record that expires (presence.DisconnectTTL), so
# a longer grace is a number that silently does nothing — raising it means
# raising both, together.
DISCONNECT_GRACE=15s
# Per-connection outbound queue depth.
SEND_BUFFER=32
MAX_CCU=12000
# Skill-based matchmaking. SKILL_WINDOW is the rating spread a match may open
# with; it grows by SKILL_WIDEN for every second the longest-waiting player has
# been in the queue, up to SKILL_MAX_WINDOW. That trade — quality for wait — is
# the part that makes skill matchmaking work: a perfect match nobody is in is
# worth nothing. SKILL_WINDOW=0 is the old pure-FIFO queue.
#
# Watch arena_match_skill_spread against arena_matchmaking_wait_seconds: they
# move against each other, and these three knobs are where you pick the point.
SKILL_WINDOW=200
SKILL_WIDEN=100
SKILL_MAX_WINDOW=1200
# Turn-based mode: how long a player has to move before the server plays their
# lowest card. The client is shown a shorter clock than this.
TURN_LIMIT=20s
# How long a match's three Redis keys survive. Both windows are refreshed on
# every move, so each is measured from the last one rather than from the deal.
#
# TURN_ENDED_TTL is the knob that decides the memory bill: a finished match sets
# it on its final write, and finished matches are nearly everything stored at
# any moment. A match costs about 5.6 KB across its keys, so the steady state is
# roughly matches-per-second x TURN_ENDED_TTL x 5.6 KB — at a thousand matches a
# second, every extra minute here is another 336 MB of Redis. Size it to how
# long a player may sit on a post-game screen and still reconnect, no longer.
TURN_ENDED_TTL=30m
# A backstop only, as long as a matchmaker role is running: its deadline sweeper
# plays an abandoned match out within a few TURN_LIMITs and drops it onto the
# shorter window. With no matchmaker, abandoned matches really do sit this long.
TURN_LIVE_TTL=24h

# ---------------------------------------------------------------------------
# Lifecycle and debugging
# ---------------------------------------------------------------------------
# Wait for in-flight matches to finish before closing listeners.
DRAIN_TIMEOUT=45s
SHUTDOWN_TIMEOUT=15s
# /debug/pprof. Behind ADMIN_TOKEN when ENV=production.
PPROF=false

# ---------------------------------------------------------------------------
# Match recording. Empty disables it.
#
# A replay is the seed plus the inputs — the simulation is deterministic, so
# that reproduces the match exactly, which is what makes a recording usable as
# evidence rather than just as a picture. Verify one with:
#
#     go run ./cmd/replay <dir-or-file>
#
# Sampled, not wholesale: MAX_REPLAYS matches record at once and the rest run
# untouched, because keeping every match costs more memory than the simulations
# do (~200 KB per 90-second match at 20 Hz).
# ---------------------------------------------------------------------------
REPLAY_DIR=
MAX_REPLAYS=64
