# Load-test overrides. Layered ON TOP of backend.env:
#
#   make load-docker          # compose up with this file applied
#   make load-10k             # then point the bots at it
#
# Committed on purpose — it holds no secrets, and the reason each value differs
# from production is the point of the file.

# Every bot dials from one client IP, so the per-IP limiters would cap the whole
# fleet: the run would measure HELLO_RATE_LIMIT, not the server. This is the
# only place these belong at 0.
HELLO_RATE_LIMIT=0
QUEUE_RATE_LIMIT=0
LOGIN_RATE_LIMIT=0
TURN_RATE_LIMIT=0

# Bots arrive faster than players do and must not be turned away mid-ramp.
MAX_CCU=30000

# Fill rooms immediately instead of waiting on a queue timeout, so a run reaches
# steady state inside its ramp rather than after it.
MIN_PLAYERS=1
QUEUE_TIMEOUT=1s

# Short matches so a run cycles through many of them rather than measuring one.
MATCH_SECONDS=30
TURN_LIMIT=10s

# Bots do not log in, and a load test is measuring the gateway rather than the
# token check. Blank here overrides whatever backend.env set, which switches JWT
# off for the run — the same reason the rate limiters are zero above, and the
# same reason it belongs in this file and nowhere else.
JWT_SECRET=

# The platform tier is off for the same reason JWT is: the bots hold no
# accounts, so every queue join would be a database read for a row that does not
# exist and the run would describe Postgres rather than the netcode. Note this
# line alone is not enough under docker-compose — the base compose file sets
# PLATFORM_DSN under `environment:`, which beats every env_file, so
# docker-compose.loadtest.yml blanks it there too.
PLATFORM_DSN=

# development: the production warnings above would otherwise fire on every line
# in this file, which is correct and also unreadable. It is also what lets the
# run start at all with JWT_SECRET blank, since production refuses to.
ENV=development
PPROF=true
